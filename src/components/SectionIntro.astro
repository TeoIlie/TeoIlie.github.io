---
interface Props {
  eyebrow: string;
  title: string;
  /** Muted row of related links under the intro, e.g. collaborators */
  links?: { name: string; url: string }[];
  linksLabel?: string;
}

const { eyebrow, title, links = [], linksLabel } = Astro.props;
---

<header class="section-header" data-reveal>
  <span class="eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  <slot />
  {links.length > 0 && (
    <p class="related">
      {linksLabel && <span>{linksLabel}</span>}
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener">
          {link.name}
        </a>
      ))}
    </p>
  )}
</header>

<style>
  .related {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-size: 14px;

    span {
      color: var(--text-muted);
    }

    a {
      font-weight: 500;
      text-decoration: none;
    }
  }
</style>
