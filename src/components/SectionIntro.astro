---
import { eyebrow, type SectionId } from '../data/site';
import type { Link } from '../lib/content';

interface Props {
  /** The section this introduces; sets the numbered eyebrow, e.g. "03 · Projects" */
  id: SectionId;
  title: string;
  /** Muted row of related links under the intro, e.g. collaborators */
  links?: Link[];
  linksLabel?: string;
}

const { id, title, links = [], linksLabel } = Astro.props;
---

<header class="section-header" data-reveal>
  <span class="eyebrow">{eyebrow(id)}</span>
  <h2>{title}</h2>
  <slot />
  {links.length > 0 && (
    <div class="related">
      {linksLabel && <span>{linksLabel}</span>}
      {links.map((link) => (
        <a href={link.url} target="_blank" rel="noopener">
          {link.name}
        </a>
      ))}
    </div>
  )}
</header>

<style>
  .related {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 16px;
    font-size: 14px;

    span {
      color: var(--text-muted);
    }

    a {
      font-weight: 500;
    }
  }
</style>
