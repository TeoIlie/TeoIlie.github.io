---
import Chips from './Chips.astro';
import Hero from './Hero.astro';
import SectionIntro from './SectionIntro.astro';
import { interests, education } from '../data/profile';
---

<Hero />

<div class="about">
  <SectionIntro id="about" title="From simulation to the real world" />

  <div class="bio" data-reveal>
    <p>
      My Master's research at Queen's, with{' '}
      <a href="https://ingenuitylabs.queensu.ca/" target="_blank" rel="noopener">
        Ingenuity Labs
      </a>{' '}
      and the{' '}
      <a href="https://labs.cs.queensu.ca/quarrg/" target="_blank" rel="noopener">
        QUARRG
      </a>{' '}
      lab, asked whether deep reinforcement learning can control a car at the limit of grip. To find
      out I built Gym-Khana, a parallelized simulator for training policies to race and drift, then
      took those policies off the screen and onto a physical 1/10-scale car.
    </p>
    <p>
      Alongside the research I founded Ingenuity Labs Racing, leading PhD, post-doc and MSc students
      through building a complete autonomous racing stack, from SLAM and planning to control. Four
      years as a full-stack developer at BMO taught me to write software other people depend on. Now
      I bring all of it to real machines on the Autonomy Team at MacLean Engineering.
    </p>
    <p>
      Outside of work I train in kickboxing, play guitar, and design LEGO Technic vehicles from the
      ground up.
    </p>

    <div class="details">
      <div>
        <h3 class="label">Interests</h3>
        <Chips items={interests} />
      </div>
      <div>
        <h3 class="label">Education</h3>
        <ul>
          {education.map((item) => (
            <li class="degree">
              <strong>{item.degree}</strong>
              <span>
                {item.institution} · {item.years}
              </span>
              {item.awards.length > 0 && (
                <div class="awards">
                  {item.awards.map((award) => (
                    <a href={award.url} target="_blank" rel="noopener">
                      {award.name}
                    </a>
                  ))}
                </div>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 48px;
    /* Same rhythm as the section boundaries in index.astro */
    margin-top: var(--section-space);
    padding-top: var(--section-space);
    border-top: 1px solid var(--border);

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    /* The heading sits in the left column here, not above the content */
    :global(.section-header) {
      margin-bottom: 0;
    }
  }

  .bio > p {
    font-size: 17px;
    margin-bottom: 16px;
  }

  .details {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    margin-top: 40px;

    @media (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .degree {
    margin-bottom: 16px;

    strong {
      display: block;
      font-size: 15px;
      font-weight: 500;
    }

    span {
      display: block;
      font-size: 14px;
      color: var(--text-muted);
    }
  }

  .awards {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;

    a {
      padding: 1px 8px;
      border: 1px solid color-mix(in oklch, var(--accent) 35%, var(--border));
      border-radius: 6px;
      font-size: 12px;
      font-weight: 500;
      transition: background-color 0.15s ease;

      &:hover {
        background-color: color-mix(in oklch, var(--accent) 10%, transparent);
      }
    }
  }
</style>
