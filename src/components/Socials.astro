---
import Icon from './Icon.astro';
---

<div class="section-heading">
  <h2>Connect With Me</h2>

  <ul class="contact-info" data-reveal>
    <li class="contact-item">
      <Icon name="solid/envelope" />
      <a href="mailto:teo.altum.quinque@gmail.com">teo.altum.quinque@gmail.com</a>
    </li>
    <li class="contact-item">
      <Icon name="solid/phone" />
      <a href="tel:+14166686650">+1 (416) 668-6650</a>
    </li>
    <li class="contact-item">
      <Icon name="brands/discord" />
      <button type="button" class="copy-discord" data-copy="teoilie">
        teoilie
      </button>
      <span class="copied-message" role="status"></span>
    </li>
  </ul>

  <div class="contact-form" data-reveal>
    <h3>Send me a message</h3>

    <form action="https://formspree.io/f/moveyaaw" method="POST">
      <div class="form-group">
        <label for="name" class="visually-hidden">
          Your Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          autocomplete="name"
          placeholder="Your Name"
          required
        />
        <p class="validation-error">Name is required.</p>
      </div>
      <div class="form-group">
        <label for="email" class="visually-hidden">
          Your Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          placeholder="Your Email"
          required
        />
        <p class="validation-error">Please enter a valid email address.</p>
      </div>
      <div class="form-group">
        <label for="message" class="visually-hidden">
          Your Message
        </label>
        <textarea
          id="message"
          name="message"
          placeholder="Your Message"
          rows="5"
          required
        ></textarea>
        <p class="validation-error">Message is required.</p>
      </div>
      <button type="submit">Send Message</button>
    </form>

    <p class="form-status success-message" role="status" hidden>
      🎉 Message sent successfully! I'll get back to you soon.
    </p>
    <p class="form-status error-message" role="alert" hidden>
      ❌ Oops! Something went wrong. Please try again later.
    </p>
  </div>
</div>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('.copy-discord')!;
  const copiedMessage = copyButton.nextElementSibling!;
  copyButton.addEventListener('click', async () => {
    await navigator.clipboard.writeText(copyButton.dataset.copy!);
    copiedMessage.textContent = 'Copied!';
    setTimeout(() => (copiedMessage.textContent = ''), 2000);
  });

  // Submit via fetch so the visitor stays on the page; without JS the form
  // still posts to Formspree directly.
  const form = document.querySelector<HTMLFormElement>('.contact-form form')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const success = document.querySelector<HTMLElement>('.success-message')!;
  const failure = document.querySelector<HTMLElement>('.error-message')!;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    submit.disabled = true;
    submit.textContent = 'Sending...';
    success.hidden = failure.hidden = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Formspree responded ${response.status}`);
      form.reset();
      success.hidden = false;
      setTimeout(() => (success.hidden = true), 5000);
    } catch (error) {
      console.error('Form submission error:', error);
      failure.hidden = false;
    } finally {
      submit.disabled = false;
      submit.textContent = 'Send Message';
    }
  });
</script>

<style lang="scss">
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  // ---------- Contact info ----------
  .contact-info {
    max-width: 600px;
    margin: 0 auto 30px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    list-style: none;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 4px;

    > :global(.icon) {
      font-size: 22px;
      width: 30px;
      color: var(--section-underline);
    }

    > :global(.icon),
    a,
    .copy-discord {
      transition:
        transform 0.2s ease,
        color 0.2s ease;
    }

    a,
    .copy-discord {
      color: var(--body-color);
      font-size: 16px;
      text-decoration: none;
    }

    .copy-discord {
      background: none;
      border: none;
      font-weight: 300;
      cursor: pointer;
    }

    &:hover {
      > :global(.icon),
      a,
      .copy-discord {
        color: var(--section-underline);
        transform: translateX(5px);
      }
    }
  }

  .copied-message {
    font-size: 14px;
    color: var(--section-underline);
  }

  // ---------- Form ----------
  .contact-form {
    max-width: 600px;
    margin: 0 auto;
    padding: 30px;
    background-color: var(--white);
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);

    h3 {
      font-size: 24px;
      margin-bottom: 20px;
      text-align: center;
      color: var(--body-color);
    }
  }

  .form-group {
    margin-bottom: 20px;

    input,
    textarea {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--form-border);
      border-radius: 4px;
      font-size: 16px;
      background-color: var(--white);
      color: var(--body-color);
      transition:
        border-color 0.3s ease,
        box-shadow 0.3s ease;

      &::placeholder {
        color: var(--subtitle);
      }

      &:focus {
        outline: none;
        border-color: var(--section-underline);
        box-shadow: 0 0 3px var(--section-underline);
      }
    }
  }

  // Shown only after the visitor has interacted with an invalid field
  .validation-error {
    display: none;
    color: #dc3545;
    font-size: 14px;
    margin: 5px 0 0;
  }

  :user-invalid + .validation-error {
    display: block;
  }

  :global(.dark-theme) .validation-error {
    color: #ff6b6b;
  }

  button[type='submit'] {
    display: block;
    width: 100%;
    padding: 12px;
    background-color: var(--section-underline);
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    transition: background-color 0.3s ease;

    &:hover {
      background-color: var(--hover-color);
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .form-status {
    margin: 20px 0 0;
    padding: 15px;
    border-radius: 8px;
    text-align: center;
    font-weight: bold;
  }

  .success-message {
    background-color: #d4edda;
    color: #155724;
  }

  .error-message {
    background-color: #f8d7da;
    color: #721c24;
  }

  :global(.dark-theme) {
    .success-message {
      background-color: #1a4a1a;
      color: #90ee90;
    }

    .error-message {
      background-color: #4a1a1a;
      color: #ff9999;
    }
  }
</style>
