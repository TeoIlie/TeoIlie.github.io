---
import Icon from './Icon.astro';

interface Props {
  name: string;
  url: string;
  icon?: string;
}

const { name, url, icon = inferIcon(url) } = Astro.props;

function inferIcon(url: string) {
  if (url.includes('github.com')) return 'brands/github';
  if (/youtube\.com|youtu\.be/.test(url)) return 'brands/youtube';
  if (url.endsWith('.pdf')) return 'solid/paperclip';
  if (url.includes('eurobricks.com')) return 'solid/comments';
  return 'solid/up-right-from-square';
}
---

<a href={url} target="_blank" rel="noopener" class="link-button">
  <Icon name={icon} />
  <span>{name}</span>
</a>
