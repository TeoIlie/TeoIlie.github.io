---
import Icon from './Icon.astro';
import Logo from '../assets/logo.svg';
import { profile } from '../data/profile';
import { sections } from '../data/site';
---

<header>
  <div class="bar container">
    <a href="/" class="logo">
      <Logo width="22" height="20" aria-hidden="true" /> {profile.name}
    </a>

    <!-- On mobile the nav is a native popover: open/close, Esc and outside-click come free -->
    <nav id="site-nav" popover aria-label="Main">
      <ul>
        {sections.map((section) => (
          <li>
            <a href={`/#${section.id}`}>{section.nav}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="theme-toggle icon-button" type="button" role="switch" aria-label="Dark mode">
      <Icon name="solid/sun" class="sun" />
      <Icon name="solid/moon" class="moon" />
    </button>

    <button
      class="menu-toggle icon-button"
      type="button"
      popovertarget="site-nav"
      aria-label="Menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const nav = document.querySelector<HTMLElement>('#site-nav')!;

  const sync = () =>
    toggle.setAttribute('aria-checked', String(root.classList.contains('dark-theme')));
  sync();

  toggle.addEventListener('click', () => {
    const theme = root.classList.contains('dark-theme') ? 'light' : 'dark';
    root.classList.toggle('dark-theme', theme === 'dark');
    try {
      // Read before first paint by the inline script in BaseLayout.astro
      localStorage.setItem('preferred-theme', theme);
    } catch {}
    sync();
  });

  // Close the mobile menu once a section is chosen
  nav.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a') && nav.matches(':popover-open')) nav.hidePopover();
  });
</script>

<style>
  header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 1000;
    height: var(--header-height);
    background-color: color-mix(in oklch, var(--bg) 78%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    height: 100%;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    white-space: nowrap;

    &:hover {
      color: var(--text);
    }
  }

  nav ul {
    display: flex;
    gap: 4px;
  }

  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
    transition:
      color 0.15s ease,
      background-color 0.15s ease;

    &:hover {
      color: var(--text);
      background-color: var(--surface-2);
    }
  }

  /* Icon button that shows the sun in light mode and the moon in dark mode */
  .theme-toggle,
  .menu-toggle {
    border: 1px solid var(--border);

    &:hover {
      border-color: color-mix(in oklch, var(--text) 25%, var(--border));
    }
  }

  .theme-toggle {
    margin-left: 8px;

    :global(.icon) {
      grid-area: 1 / 1;
      font-size: 15px;
      transition:
        opacity 0.2s ease,
        rotate 0.3s ease;
    }

    :global(.moon) {
      opacity: 0;
      rotate: -90deg;
    }
  }

  :global(.dark-theme) .theme-toggle {
    :global(.sun) {
      opacity: 0;
      rotate: 90deg;
    }

    :global(.moon) {
      opacity: 1;
      rotate: 0deg;
    }
  }

  .menu-toggle {
    display: none;
  }

  /* Desktop: undo the popover so the nav sits inline */
  @media (min-width: 861px) {
    nav[popover] {
      display: block;
      position: static;
      inset: auto;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0;
      border: none;
      background: none;
      overflow: visible;
    }
  }

  @media (max-width: 860px) {
    /* Two lines that cross into an X while the menu is open */
    .menu-toggle {
      display: grid;
      position: relative;

      span {
        position: absolute;
        left: 10px;
        width: 14px;
        height: 1.5px;
        border-radius: 1px;
        background: var(--text);
        transition:
          rotate 0.25s ease,
          top 0.25s ease;
      }

      span:nth-child(1) {
        top: 14px;
      }
      span:nth-child(2) {
        top: 20px;
      }
    }

    header:has(nav:popover-open) .menu-toggle {
      span:nth-child(1) {
        top: 17px;
        rotate: 45deg;
      }
      span:nth-child(2) {
        top: 17px;
        rotate: -45deg;
      }
    }

    nav[popover] {
      inset: var(--header-height) 0 auto;
      width: 100%;
      margin: 0;
      padding: 8px 16px 16px;
      border: none;
      border-bottom: 1px solid var(--border);
      background-color: var(--bg);

      ul {
        flex-direction: column;
        gap: 2px;
      }

      a {
        padding: 10px 12px;
        font-size: 16px;
      }
    }
  }
</style>
