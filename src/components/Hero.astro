---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import LinkButton from './LinkButton.astro';
import photo from '../assets/images/profile-1200.jpg';
import { profile, socials, readouts } from '../data/profile';

// The full list lives in the Contact section
const heroSocials = socials.filter((s) => s.hero);

// Racing line behind the hero, pinned to its bottom edge and scaled uniformly (so pathLength stays
// exact): low under the text on the left, rising behind the photo and off the top right
const racingLine = 'M 0 359 C 250 366, 470 366, 590 311 S 760 44, 1000 7';
---

<div class="hero">
  <!-- Decorative: an optimal racing line that draws itself once, with an RViz-style TF frame driving it -->
  <svg class="racing-line" viewBox="0 0 1000 370" aria-hidden="true">
    <path class="track" d={racingLine} />
    <path class="line" d={racingLine} pathLength="1" />
    <!-- x along the heading, y to its left, z out of the screen; offset-path turns it with the line -->
    <g class="car" style={`offset-path: path('${racingLine}')`}>
      <line class="x" x2="16" />
      <line class="y" y2="-16" />
      <circle class="z" r="2.6" />
    </g>
  </svg>
  <!-- Follows the cursor over the hero until the easter egg is used -->
  <span class="pose-hint chip" aria-hidden="true">
    click · set initial pose
  </span>

  <div class="intro">
    <h1>{profile.name}</h1>
    <p class="statement">
      I build vehicles that <span>drive themselves</span>.
    </p>
    <p class="headline">{profile.headline}</p>
    <div class="link-row actions">
      <LinkButton name="View projects" url="/#projects" primary />
      <LinkButton name="Resume" url={profile.resume} />
      <span class="divider" aria-hidden="true"></span>
      <ul class="socials">
        {heroSocials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener me" class="icon-button">
              <Icon name={social.icon} label={social.name} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <Picture
    src={photo}
    alt={profile.name}
    width={680}
    height={680}
    widths={[160, 240, 340, 480, 680]}
    sizes="(max-width: 860px) 160px, (max-width: 1214px) 28vw, 340px"
    formats={['avif', 'webp']}
    loading="eager"
    fetchpriority="high"
  />
</div>

<dl class="readouts label">
  {readouts.map((item) => (
    <div>
      <dt>{item.key}</dt>
      <dd>{item.value}</dd>
    </div>
  ))}
</dl>

<script>
  // Easter egg, like RViz's "2D Pose Estimate": clicking the hero places the TF frame there, and
  // the line redraws from it, merging onto the racing line ahead (like pure pursuit's lookahead)
  // and following it to the end at the original speed
  const hero = document.querySelector<HTMLElement>('.hero');
  const svg = hero?.querySelector<SVGSVGElement>('.racing-line');
  if (hero && svg) {
    const track = svg.querySelector<SVGPathElement>('.track')!;
    const line = svg.querySelector<SVGPathElement>('.line')!;
    const car = svg.querySelector<SVGGElement>('.car')!;
    const hint = hero.querySelector<HTMLElement>('.pose-hint')!;
    const hover = new AbortController(); // Retires the hint once the egg has been found
    const step = 4; // Track sampling distance in viewBox units: nearest-point search and redrawn path
    const samples: DOMPoint[] = []; // Taken on the first click, so page load does no layout reads
    let length = 0;
    let duration = 0; // The CSS duration (ms), before any replay overrides it

    const at = (s: number) => track.getPointAtLength(Math.min(Math.max(s, 0), length));
    const dist = (u: DOMPoint, v: DOMPoint) => Math.hypot(v.x - u.x, v.y - u.y);
    const fmt = (...values: number[]) => values.map((n) => n.toFixed(1)).join(' ');
    // Links and buttons keep their job: no hint over them, and clicks pass through
    const onControl = (e: Event) => (e.target as Element).closest('a, button');

    // Hover hint over the hero's empty space (CSS only displays it where the egg is enabled)
    const { signal } = hover;
    hero.addEventListener(
      'pointermove',
      (e) => {
        const show = e.pointerType === 'mouse' && !onControl(e);
        hint.classList.toggle('visible', show);
        if (show) hint.style.translate = `${e.clientX + 10}px ${e.clientY + 10}px`;
      },
      { signal }
    );
    hero.addEventListener('pointerleave', () => hint.classList.remove('visible'), { signal });

    hero.addEventListener('click', (e) => {
      const ctm = svg.getScreenCTM();
      const animations = [...line.getAnimations(), ...car.getAnimations()];
      // Hidden on mobile, and static under reduced motion (no animations to replay); a drag that
      // selected text isn't a click
      if (!ctm || !svg.getBoundingClientRect().width || !animations.length) return;
      if (onControl(e) || !getSelection()?.isCollapsed) return;
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(ctm.inverse());
      hover.abort();
      hint.remove();

      if (!samples.length) {
        length = track.getTotalLength();
        duration = animations[0].effect!.getTiming().duration as number;
        for (let s = 0; s < length; s += step) samples.push(at(s));
        samples.push(at(length));
      }

      // Nearest sample on the track, and how far the click is from it
      let nearest = 0;
      let gap = Infinity;
      samples.forEach((q, i) => {
        const r = dist(p, q);
        if (r < gap) {
          gap = r;
          nearest = i * step;
        }
      });

      // The further the click, the further ahead it merges, so the approach stays gentle
      const join = Math.min(nearest + Math.max(length * 0.1, gap * 2), length);
      const j = at(join);
      const a = at(join - 1);
      const b = at(join + 1);
      // Cubic connector: leaves the click facing the merge point, with a long arm along the
      // track's heading into the merge so it arrives tangent instead of hooking on
      const k = (dist(p, j) * 0.5) / dist(a, b);
      let d = `M ${fmt(p.x, p.y)} C ${fmt(p.x + (j.x - p.x) * 0.3, p.y + (j.y - p.y) * 0.3)}, `;
      d += `${fmt(j.x - (b.x - a.x) * k, j.y - (b.y - a.y) * k)}, ${fmt(j.x, j.y)}`;
      // Then the rest of the track, so the frame turns smoothly through the samples
      for (const q of samples.slice(Math.floor(join / step) + 1)) d += ` L ${fmt(q.x, q.y)}`;

      line.setAttribute('d', d);
      car.style.offsetPath = `path('${d}')`;
      // Replay at the original speed: the duration scales with the new path's length
      const runtime = Math.max((duration * line.getTotalLength()) / length, 600);
      for (const animation of animations) {
        animation.effect!.updateTiming({ duration: runtime, delay: 0 });
        animation.currentTime = 0;
        animation.play();
      }
    });
  }
</script>

<style>
  .hero {
    position: relative;
    /* Keeps the racing line's negative z-index inside the hero */
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    min-height: min(60vh, 540px);

    /* Where the easter egg is enabled (desktop, like the line; not under reduced motion, where the
       line doesn't replay): a crosshair cursor and the hover hint */
    @media (min-width: 861px) and (prefers-reduced-motion: no-preference) {
      cursor: crosshair;

      .pose-hint {
        display: block;
      }
    }

    @media (max-width: 860px) {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 32px;
      min-height: 0;
    }

    /* <Picture> wraps the img: the wrapper is the flex item, so it mustn't shrink */
    picture {
      flex-shrink: 0;
    }

    /* Fixed square that scales with the viewport, so the circle never squashes */
    img {
      display: block;
      width: clamp(240px, 28vw, 340px);
      max-width: none;
      height: auto;
      aspect-ratio: 1;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--border);
      padding: 6px;
      background-color: var(--surface);

      @media (max-width: 860px) {
        width: 160px;
        padding: 4px;
      }
    }
  }

  .intro {
    max-width: 640px;
  }

  /* A chip the script moves to just below-right of the cursor; displayed only by the .hero rule */
  .pose-hint {
    display: none;
    position: fixed;
    z-index: 1;
    top: 0;
    left: 0;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;

    &.visible {
      opacity: 1;
    }
  }

  /* Bleeds past the container so the line enters and leaves the screen */
  .racing-line {
    position: absolute;
    z-index: -1;
    left: -15vw;
    bottom: 0;
    width: calc(100% + 30vw);
    height: auto;
    overflow: visible;
    pointer-events: none;
    /* Own layer: each frame repaints only the SVG, not the text and grid around it */
    will-change: transform;

    @media (max-width: 860px) {
      display: none;
    }

    /* Stroke widths are in viewBox units (~1.5px each at desktop widths) */
    path {
      fill: none;
    }

    .track {
      stroke: var(--border);
      stroke-width: 0.8;
      stroke-dasharray: 4 6;
    }

    /* One timing for both, so the frame rides the line's drawing tip. The delay lets first paint,
       the photo decode and font swap settle so the slow opening frames don't stutter. Longhands:
       lightningcss turns a shorthand without a name into "animation: none" */
    .line,
    .car {
      animation-duration: 2.6s;
      animation-timing-function: cubic-bezier(0.3, 0, 0.2, 1);
      animation-delay: 0.25s;
      animation-fill-mode: both;
    }

    /* Dash length = path length, so shifting the offset from 1 to 0 draws the line */
    .line {
      stroke: color-mix(in oklch, var(--accent) 60%, transparent);
      stroke-width: 1;
      stroke-dasharray: 1 2;
      animation-name: draw;
    }

    .car {
      animation-name: drive;
    }

    .car line {
      stroke-width: 2;
      stroke-linecap: round;
    }

    .x {
      stroke: light-dark(#e5484d, #ff6b6b);
    }

    .y {
      stroke: light-dark(#2f9e5b, #4cc38a);
    }

    .z {
      fill: var(--accent);
    }

    @media (prefers-reduced-motion: reduce) {
      .line {
        animation: none;
        stroke-dashoffset: 0;
      }

      .car {
        display: none;
      }
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes drive {
    to {
      offset-distance: 100%;
    }
  }

  .readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--border);

    div {
      display: flex;
      align-items: center;
      gap: 10px;

      &::before {
        content: '';
        width: 5px;
        height: 5px;
        background-color: var(--accent);
      }
    }

    dd {
      color: var(--text);
    }
  }

  .statement {
    margin-top: 16px;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text);

    span {
      color: var(--accent);
    }
  }

  .headline {
    max-width: 520px;
    margin-top: 16px;
    font-size: 17px;
  }

  /* Staggered entrance: hero items rise in one after another */
  @media (prefers-reduced-motion: no-preference) {
    .intro > *,
    .hero :global(picture) {
      animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .intro > :nth-child(2) {
      animation-delay: 80ms;
    }
    .intro > :nth-child(3) {
      animation-delay: 160ms;
    }
    .intro > :nth-child(4),
    .hero :global(picture) {
      animation-delay: 240ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  .actions {
    align-items: center;
  }

  .divider {
    width: 1px;
    height: 24px;
    margin: 0 4px;
    background-color: var(--border);
  }

  .socials {
    display: flex;
    gap: 2px;

    a {
      font-size: 18px;
    }
  }
</style>
