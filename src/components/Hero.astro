---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import LinkButton from './LinkButton.astro';
import photo from '../assets/images/profile-1200.jpg';
import { profile, socials, readouts } from '../data/profile';

// The full list lives in the Contact section
const heroSocials = socials.filter((s) => s.hero);

// Racing line behind the hero, pinned to its bottom edge and scaled uniformly (so pathLength stays
// exact): low under the text on the left, rising behind the photo and off the top right
const racingLine = 'M 0 359 C 250 366, 470 366, 590 311 S 760 44, 1000 7';
---

<div class="hero">
  <!-- Decorative: an optimal racing line that draws itself once, with a car-dot following it -->
  <svg class="racing-line" viewBox="0 0 1000 370" aria-hidden="true">
    <path class="track" d={racingLine} />
    <path class="line" d={racingLine} pathLength="1" />
    <!-- A zero-length dash with round caps draws a dot that can ride the line -->
    <path class="car" d={racingLine} pathLength="1" />
  </svg>

  <div class="intro">
    <h1>{profile.name}</h1>
    <p class="statement">
      I build vehicles that <span>drive themselves</span>.
    </p>
    <p class="headline">{profile.headline}</p>
    <div class="link-row actions">
      <LinkButton name="View projects" url="/#projects" primary />
      <LinkButton name="Resume" url={profile.resume} />
      <span class="divider" aria-hidden="true"></span>
      <ul class="socials">
        {heroSocials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener me" class="icon-button">
              <Icon name={social.icon} label={social.name} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <Picture
    src={photo}
    alt={profile.name}
    width={680}
    height={680}
    widths={[160, 240, 340, 480, 680]}
    sizes="(max-width: 860px) 160px, (max-width: 1214px) 28vw, 340px"
    formats={['avif', 'webp']}
    loading="eager"
    fetchpriority="high"
  />
</div>

<dl class="readouts label">
  {readouts.map((item) => (
    <div>
      <dt>{item.key}</dt>
      <dd>{item.value}</dd>
    </div>
  ))}
</dl>

<style>
  .hero {
    position: relative;
    /* Keeps the racing line's negative z-index inside the hero */
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
    min-height: min(60vh, 540px);

    @media (max-width: 860px) {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 32px;
      min-height: 0;
    }

    /* <Picture> wraps the img: the wrapper is the flex item, so it mustn't shrink */
    picture {
      flex-shrink: 0;
    }

    /* Fixed square that scales with the viewport, so the circle never squashes */
    img {
      display: block;
      width: clamp(240px, 28vw, 340px);
      max-width: none;
      height: auto;
      aspect-ratio: 1;
      border-radius: 50%;
      object-fit: cover;
      border: 1px solid var(--border);
      padding: 6px;
      background-color: var(--surface);

      @media (max-width: 860px) {
        width: 160px;
        padding: 4px;
      }
    }
  }

  .intro {
    max-width: 640px;
  }

  /* Bleeds past the container so the line enters and leaves the screen */
  .racing-line {
    position: absolute;
    z-index: -1;
    left: -15vw;
    bottom: 0;
    width: calc(100% + 30vw);
    height: auto;
    overflow: visible;
    pointer-events: none;

    @media (max-width: 860px) {
      display: none;
    }

    /* Stroke widths are in viewBox units (~1.5px each at desktop widths) */
    path {
      fill: none;
    }

    .track {
      stroke: var(--border);
      stroke-width: 0.8;
      stroke-dasharray: 4 6;
    }

    /* Dash length = path length, so shifting the offset from 1 to 0 draws the line */
    .line {
      stroke: color-mix(in oklch, var(--accent) 60%, transparent);
      stroke-width: 1;
      stroke-dasharray: 1 2;
      animation: draw 2.6s cubic-bezier(0.3, 0, 0.2, 1) both;
    }

    /* The dot sits at -offset along the path, so 0 -> -1 drives it start to finish */
    .car {
      stroke: var(--accent);
      stroke-width: 6;
      stroke-linecap: round;
      stroke-dasharray: 0.0001 2;
      stroke-dashoffset: -1;
      animation: drive 2.6s cubic-bezier(0.3, 0, 0.2, 1) both;
    }

    @media (prefers-reduced-motion: reduce) {
      .line {
        animation: none;
        stroke-dashoffset: 0;
      }

      .car {
        display: none;
      }
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drive {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -1;
    }
  }

  .readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 32px;
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--border);

    div {
      display: flex;
      align-items: center;
      gap: 10px;

      &::before {
        content: '';
        width: 5px;
        height: 5px;
        background-color: var(--accent);
      }
    }

    dd {
      color: var(--text);
    }
  }

  .statement {
    margin-top: 16px;
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text);

    span {
      color: var(--accent);
    }
  }

  .headline {
    max-width: 520px;
    margin-top: 16px;
    font-size: 17px;
  }

  /* Staggered entrance: hero items rise in one after another */
  @media (prefers-reduced-motion: no-preference) {
    .intro > *,
    .hero :global(picture) {
      animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .intro > :nth-child(2) {
      animation-delay: 80ms;
    }
    .intro > :nth-child(3) {
      animation-delay: 160ms;
    }
    .intro > :nth-child(4),
    .hero :global(picture) {
      animation-delay: 240ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  .actions {
    align-items: center;
  }

  .divider {
    width: 1px;
    height: 24px;
    margin: 0 4px;
    background-color: var(--border);
  }

  .socials {
    display: flex;
    gap: 2px;

    a {
      font-size: 18px;
    }
  }
</style>
