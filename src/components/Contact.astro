---
import Icon from './Icon.astro';
import LinkButton from './LinkButton.astro';
import SectionIntro from './SectionIntro.astro';
import { profile, socials } from '../data/profile';
---

<div class="contact">
  <div>
    <SectionIntro id="contact" title="Let's talk">
      <p>Open to research collaborations, engineering roles, and LEGO Technic chats.</p>
    </SectionIntro>

    <ul class="contact-info" data-reveal>
      <li>
        <Icon name="solid/envelope" />
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </li>
      <li>
        <Icon name="solid/phone" />
        <a href={profile.phone.href}>{profile.phone.display}</a>
      </li>
      <li>
        <Icon name="brands/discord" />
        <button type="button" class="copy" data-copy={profile.discord}>
          {profile.discord}
        </button>
        <span class="copied" role="status"></span>
      </li>
    </ul>

    <h3 class="label">Elsewhere</h3>
    <ul class="socials" data-reveal>
      {socials.map((social) => (
        <li>
          <LinkButton {...social} />
        </li>
      ))}
    </ul>
  </div>

  <div class="card contact-form" data-reveal>
    <!-- Posts straight to Formspree without JS; the script below keeps visitors on the page -->
    <form action={profile.formAction} method="POST">
      <label>
        <span>Name</span>
        <input type="text" name="name" autocomplete="name" required />
        <small>Name is required.</small>
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required />
        <small>Please enter a valid email address.</small>
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="5" required></textarea>
        <small>Message is required.</small>
      </label>
      <button type="submit" class="link-button link-button--primary">
        Send message
      </button>
    </form>

    <p class="status success" role="status" hidden>
      Message sent. I'll get back to you soon.
    </p>
    <p class="status error" role="alert" hidden>
      Something went wrong. Please try again later.
    </p>
    <p class="note">Sent securely and never shared with third parties.</p>
  </div>
</div>

<script>
  const copy = document.querySelector<HTMLButtonElement>('.contact-info .copy')!;
  const copied = copy.nextElementSibling!;
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copy!);
      copied.textContent = 'Copied!';
    } catch {
      copied.textContent = 'Copy failed';
    }
    setTimeout(() => (copied.textContent = ''), 2000);
  });

  const form = document.querySelector<HTMLFormElement>('.contact-form form')!;
  const submit = form.querySelector('button')!;
  const [success, failure] = document.querySelectorAll<HTMLElement>('.contact-form .status');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    submit.disabled = true;
    submit.textContent = 'Sending...';
    success.hidden = failure.hidden = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Formspree responded ${response.status}`);
      form.reset();
      success.hidden = false;
      setTimeout(() => (success.hidden = true), 5000);
    } catch (error) {
      console.error('Form submission error:', error);
      failure.hidden = false;
    } finally {
      submit.disabled = false;
      submit.textContent = 'Send message';
    }
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .contact-info {
    li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 6px 0;
    }

    :global(.icon) {
      width: 18px;
      font-size: 16px;
      color: var(--text-muted);
    }

    a,
    .copy {
      font-size: 16px;
      color: var(--text);
      transition: color 0.15s ease;

      &:hover {
        color: var(--accent);
      }
    }

    .copy {
      border: none;
      background: none;
      cursor: pointer;
    }
  }

  .copied {
    font-size: 13px;
    color: var(--accent);
  }

  .label {
    margin-top: 32px;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    /* Compact link buttons with muted icons that pick up the accent on hover */
    :global(.link-button) {
      height: 36px;
      padding: 0 12px;
    }

    :global(.icon) {
      color: var(--text-muted);
    }

    :global(.link-button:hover .icon) {
      color: inherit;
    }
  }

  .contact-form {
    padding: clamp(20px, 4vw, 32px);
  }

  label {
    display: block;
    margin-bottom: 16px;

    > span {
      display: block;
      margin-bottom: 6px;
      font-size: 14px;
      font-weight: 500;
    }
  }

  input,
  textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 16px;
    color: var(--text);
    background-color: var(--bg);
    resize: vertical;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;

    &:focus {
      outline: none;
      border-color: var(--accent);
      box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 20%, transparent);
    }
  }

  /* Validation message, shown only after the visitor has interacted with an invalid field */
  small {
    display: none;
    margin-top: 6px;
    font-size: 13px;
    color: var(--error);
  }

  :user-invalid {
    border-color: var(--error);
  }

  :user-invalid + small {
    display: block;
  }

  button[type='submit'] {
    width: 100%;
    justify-content: center;
    margin-top: 4px;
    cursor: pointer;

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .status {
    margin-top: 16px;
    padding: 10px 14px;
    border: 1px solid currentColor;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .success {
    color: var(--success);
  }

  .error {
    color: var(--error);
  }

  .note {
    margin-top: 16px;
    font-size: 13px;
    text-align: center;
  }
</style>
