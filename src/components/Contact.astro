---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
---

<h2 class="section-title heading-underline">Connect With Me</h2>

<ul class="contact-info" data-reveal>
  <li>
    <Icon name="solid/envelope" />
    <a href={`mailto:${profile.email}`}>{profile.email}</a>
  </li>
  <li>
    <Icon name="solid/phone" />
    <a href={profile.phone.href}>{profile.phone.display}</a>
  </li>
  <li>
    <Icon name="brands/discord" />
    <button type="button" class="copy" data-copy={profile.discord}>
      {profile.discord}
    </button>
    <span class="copied" role="status"></span>
  </li>
</ul>

<div class="card contact-form" data-reveal>
  <h3>Send me a message</h3>

  <!-- Posts straight to Formspree without JS; the script below keeps visitors on the page -->
  <form action="https://formspree.io/f/moveyaaw" method="POST">
    <label>
      <span class="visually-hidden">Your Name</span>
      <input type="text" name="name" autocomplete="name" placeholder="Your Name" required />
      <small>Name is required.</small>
    </label>
    <label>
      <span class="visually-hidden">Your Email</span>
      <input type="email" name="email" autocomplete="email" placeholder="Your Email" required />
      <small>Please enter a valid email address.</small>
    </label>
    <label>
      <span class="visually-hidden">Your Message</span>
      <textarea name="message" placeholder="Your Message" rows="5" required></textarea>
      <small>Message is required.</small>
    </label>
    <button type="submit">Send Message</button>
  </form>

  <p class="status success" role="status" hidden>
    🎉 Message sent successfully! I'll get back to you soon.
  </p>
  <p class="status error" role="alert" hidden>
    ❌ Oops! Something went wrong. Please try again later.
  </p>
</div>

<script>
  const copy = document.querySelector<HTMLButtonElement>('.contact-info .copy')!;
  copy.addEventListener('click', async () => {
    await navigator.clipboard.writeText(copy.dataset.copy!);
    copy.nextElementSibling!.textContent = 'Copied!';
    setTimeout(() => (copy.nextElementSibling!.textContent = ''), 2000);
  });

  const form = document.querySelector<HTMLFormElement>('.contact-form form')!;
  const submit = form.querySelector('button')!;
  const [success, failure] = document.querySelectorAll<HTMLElement>('.contact-form .status');

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    submit.disabled = true;
    submit.textContent = 'Sending...';
    success.hidden = failure.hidden = true;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(`Formspree responded ${response.status}`);
      form.reset();
      success.hidden = false;
      setTimeout(() => (success.hidden = true), 5000);
    } catch (error) {
      console.error('Form submission error:', error);
      failure.hidden = false;
    } finally {
      submit.disabled = false;
      submit.textContent = 'Send Message';
    }
  });
</script>

<style>
  .contact-info {
    max-width: 600px;
    margin: 0 auto 30px;

    li {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 4px;
    }

    :global(.icon) {
      width: 30px;
      font-size: 22px;
      color: var(--section-underline);
    }

    a,
    .copy {
      font-size: 16px;
      color: var(--body-color);
    }

    .copy {
      border: none;
      background: none;
      font-weight: 300;
      cursor: pointer;
    }

    :global(.icon),
    a,
    .copy {
      transition:
        translate 0.2s ease,
        color 0.2s ease;
    }
  }

  .contact-info li:hover > :not(.copied) {
    translate: 5px;
    color: var(--section-underline);
    text-decoration: none;
  }

  .copied {
    font-size: 14px;
    color: var(--section-underline);
  }

  .contact-form {
    max-width: 600px;
    margin: 0 auto;
    padding: 30px;

    h3 {
      font-size: 24px;
      margin-bottom: 20px;
      text-align: center;
    }
  }

  label {
    display: block;
    margin-bottom: 20px;
  }

  input,
  textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--form-border);
    border-radius: 4px;
    font-size: 16px;
    color: var(--body-color);
    background-color: var(--white);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;

    &::placeholder {
      color: var(--subtitle);
    }

    &:focus {
      outline: none;
      border-color: var(--section-underline);
      box-shadow: 0 0 3px var(--section-underline);
    }
  }

  /* Validation message, shown only after the visitor has interacted with an invalid field */
  small {
    display: none;
    margin-top: 5px;
    font-size: 14px;
    color: #dc3545;
  }

  :user-invalid + small {
    display: block;
  }

  :global(.dark-theme) small {
    color: #ff6b6b;
  }

  button[type='submit'] {
    width: 100%;
    padding: 12px;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    color: white;
    background-color: var(--section-underline);
    cursor: pointer;
    transition: background-color 0.3s ease;

    &:hover {
      background-color: var(--hover-color);
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .status {
    margin: 20px 0 0;
    padding: 15px;
    border-radius: 8px;
    text-align: center;
    font-weight: bold;
  }

  .success {
    color: #155724;
    background-color: #d4edda;
  }

  .error {
    color: #721c24;
    background-color: #f8d7da;
  }

  :global(.dark-theme) .success {
    color: #90ee90;
    background-color: #1a4a1a;
  }

  :global(.dark-theme) .error {
    color: #ff9999;
    background-color: #4a1a1a;
  }
</style>
