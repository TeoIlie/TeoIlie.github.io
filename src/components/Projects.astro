---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import SectionIntro from './SectionIntro.astro';
import Chips from './Chips.astro';
import LinkButton from './LinkButton.astro';
import { getSorted } from '../lib/content';

// First frames extracted by `npm run prepare-videos`, shown until the video plays. Also set as
// the video's background, since Firefox drops the poster a moment before painting the first frame.
const posters = import.meta.glob<ImageMetadata>('../assets/images/posters/*.jpg', {
  eager: true,
  import: 'default',
});

const projects = await Promise.all(
  (await getSorted('projects')).map(async (entry) => {
    const poster = posters[`../assets/images/posters/${entry.data.video}.jpg`];
    if (!poster)
      throw new Error(`Missing poster for "${entry.data.video}"; run npm run prepare-videos`);
    const [{ Content }, image] = await Promise.all([
      render(entry),
      // Up to 1080px for the sharper featured videos; smaller posters are never upscaled
      getImage({ src: poster, width: Math.min(1080, poster.width), format: 'webp' }),
    ]);
    return { ...entry.data, id: entry.id, Description: Content, poster: image.src };
  })
);

const collaborators = [
  { name: 'Ingenuity Labs', url: 'https://ingenuitylabs.queensu.ca/' },
  { name: 'QUARRG Lab', url: 'https://labs.cs.queensu.ca/quarrg/' },
  { name: 'MuLab', url: 'https://mulab.ai/' },
];
---

<SectionIntro
  id="projects"
  title="Selected work"
  links={collaborators}
  linksLabel="Collaborating with"
>
  <p>
    Autonomous racing, reinforcement learning for robot navigation, probabilistic inference, and
    neural networks built from scratch.
  </p>
</SectionIntro>

<div class="projects">
  {projects.map((project) => (
    <article
      id={`project-${project.id}`}
      class:list={['card card-hover project', { featured: project.featured }]}
      data-reveal
    >
      <a
        href={project.links[0]?.url}
        target="_blank"
        rel="noopener"
        tabindex="-1"
        class="media viewfinder"
      >
        <video
          data-autoplay
          loop
          muted
          playsinline
          preload="none"
          poster={project.poster}
          style={`background: url(${project.poster}) center / cover`}
          aria-label={project.title}
        >
          <source src={`/assets/videos/${project.video}.mp4`} type="video/mp4" />
        </video>
      </a>
      <div class="info">
        <h3>{project.title}</h3>
        <project.Description />
        <Chips items={project.technologies} limit={project.featured ? undefined : 4} />
        <div class="link-row">
          {project.links.map((link, i) => (
            <LinkButton {...link} primary={project.featured && i === 0} />
          ))}
        </div>
      </div>
    </article>
  ))}
</div>

<script>
  // Only download and play project videos while they are near the screen. With
  // reduced motion the poster stays put.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        if (isIntersecting) video.play().catch(() => {});
        else video.pause();
      }
    },
    { rootMargin: '400px 0px' }
  );
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
    videos.forEach((video) => observer.observe(video));

    // Firefox is slow from play() to the first frame, so fetch and decode further ahead.
    // Starts after page load so it never competes with it; skipped under Data Saver.
    const { connection } = navigator as Navigator & { connection?: { saveData?: boolean } };
    if (!connection?.saveData) {
      const margin = matchMedia('(max-width: 860px)').matches ? 800 : 1200;
      const warm = new IntersectionObserver(
        (entries) => {
          for (const { target, isIntersecting } of entries) {
            if (!isIntersecting) continue;
            (target as HTMLVideoElement).preload = 'auto';
            warm.unobserve(target);
          }
        },
        { rootMargin: `${margin}px 0px` }
      );
      const start = () => videos.forEach((video) => warm.observe(video));
      if (document.readyState === 'complete') start();
      else addEventListener('load', start, { once: true });
    }
  }
</script>

<style>
  /* Featured projects span the full width; the rest fill a two-column grid */
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
    }
  }

  .project {
    display: flex;
    flex-direction: column;
    padding: 8px;
  }

  .featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 8px;

    @media (max-width: 860px) {
      grid-template-columns: 1fr;
    }

    .info {
      padding: 24px 28px;
    }

    h3 {
      font-size: 24px;
    }
  }

  .media {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    /* Own layer, so mobile Safari applies the rounded clip to the (separately composited) video */
    isolation: isolate;
    background-color: var(--surface-2);

    video {
      display: block;
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
    }
  }

  .info {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 16px 16px;

    h3 {
      margin-bottom: 8px;
    }

    :global(p) {
      margin-bottom: 20px;
    }

    .link-row {
      margin-top: auto;
      padding-top: 20px;
    }
  }
</style>
