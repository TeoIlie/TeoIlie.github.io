---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SectionIntro from './SectionIntro.astro';
import Chips from './Chips.astro';
import { socials } from '../data/profile';
import nico71 from '../assets/images/nico71.jpg';
import zerobricks from '../assets/images/zerobricks.jpg';
import madoca from '../assets/images/madoca.png';
import sheepo from '../assets/images/sheepo.jpg';
import efferman from '../assets/images/efferman.jpg';
import sariel from '../assets/images/sariel.png';

const creations = (await getCollection('lego')).sort((a, b) => a.data.order - b.data.order);

const communityLinks = [
  { name: 'YouTube', url: socials.find((s) => s.name === 'YouTube')!.url },
  {
    name: 'Eurobricks',
    url: 'https://www.eurobricks.com/forum/profile/120672-teo-lego-technic/',
  },
  { name: 'BrickSafe', url: 'https://bricksafe.com/pages/Teo_LEGO_Technic' },
];

const inspirations = [
  {
    name: 'Nico71',
    url: 'https://www.nico71.fr/',
    image: nico71,
    alt: 'Nico, a French Engineer and LEGO Creator',
  },
  {
    name: 'ZeroBricks',
    url: 'https://www.youtube.com/c/zerobricks',
    image: zerobricks,
    alt: 'ZeroBricks, creator of BuWizz',
  },
  {
    name: 'Madoca',
    url: 'https://www.youtube.com/@madoca1977',
    image: madoca,
    alt: 'Madoca, LEGO Technic legend',
  },
  {
    name: 'Sheepo',
    url: 'https://www.sheepo.es',
    image: sheepo,
    alt: 'Sheepo, famous for large, complex vehicles',
  },
  {
    name: 'Efferman',
    url: 'https://www.youtube.com/user/3fferman',
    image: efferman,
    alt: 'Efferman, builder of robust designs and custom parts',
  },
  {
    name: 'Sariel',
    url: 'https://sariel.pl',
    image: sariel,
    alt: 'Sariel, prolific builder with published books and an active social media presence',
  },
];
---

<SectionIntro
  eyebrow="04 · Beyond code"
  title="LEGO Technic"
  links={communityLinks}
  linksLabel="Find me on"
>
  <p>
    Over a decade of designing working vehicles from scratch: custom gearboxes, transmissions,
    suspensions and axles, each engineered from original blueprints. The same instinct drives my
    software work: building a great system isn't so different from engineering a really capable
    truck.
  </p>
</SectionIntro>

<ul class="grid">
  {creations.map(({ id, data }) => (
    <li>
      <a class="card card-hover creation" href={`/lego/${id}`} data-astro-prefetch data-reveal>
        <div class="cover viewfinder">
          <Image
            src={data.cover}
            alt=""
            widths={[360, 520, 720, 1040]}
            sizes="(max-width: 600px) calc(100vw - 66px), (max-width: 860px) calc(50vw - 50px), 330px"
          />
        </div>
        <div class="meta">
          <h3 style={`view-transition-name: lego-${id}`}>{data.title}</h3>
          <span class="mono">{data.buildYear}</span>
        </div>
        <Chips items={data.techniques} limit={2} />
      </a>
    </li>
  ))}
</ul>

<section class="inspirations" data-reveal>
  <h3 class="label">Builders who inspire me</h3>
  <ul>
    {inspirations.map((builder) => (
      <li>
        <a href={builder.url} target="_blank" rel="noopener">
          <Image src={builder.image} alt={builder.alt} width={32} height={32} densities={[1, 2]} />
          {builder.name}
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;

    @media (max-width: 860px) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (max-width: 600px) {
      grid-template-columns: 1fr;
    }
  }

  .creation {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 8px 8px 16px;
    color: inherit;

    &:hover {
      color: inherit;
    }

    :global(.chips) {
      padding: 0 8px;
    }
  }

  /* Clipped frame so the hover zoom stays inside the rounded corners */
  .cover {
    overflow: hidden;
    border-radius: 6px;
    aspect-ratio: 4 / 3;
    background-color: var(--surface-2);

    img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: scale 0.4s ease;
    }
  }

  .creation:hover .cover img {
    scale: 1.04;
  }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 8px 12px;

    h3 {
      font-size: 17px;
    }

    span {
      font-size: 13px;
      color: var(--text-muted);
      font-variant-numeric: tabular-nums;
    }
  }

  .inspirations {
    margin-top: 64px;

    ul {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 6px 16px 6px 6px;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text);
      background-color: var(--surface);
      transition: border-color 0.15s ease;

      &:hover {
        border-color: color-mix(in oklch, var(--accent) 45%, var(--border));
      }
    }

    img {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      object-fit: cover;
    }
  }
</style>
