---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import photo from '../assets/images/profile-1200.jpg';
import { profile, socials } from '../data/profile';

interface Props {
  title: string;
  description: string;
  /** Social preview image; defaults to the profile photo */
  image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
const siteName = `${profile.name} Portfolio`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const toJpg = async (src: ImageMetadata) =>
  new URL((await getImage({ src, width: 1200, format: 'jpg' })).src, Astro.site).href;
const photoUrl = await toJpg(photo);
const ogImage = image ? await toJpg(image) : photoUrl;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: profile.name,
      alternateName: 'Teo Ilie',
      url: Astro.site!.href,
      email: profile.email,
      image: photoUrl,
      sameAs: socials.map((s) => s.url),
      jobTitle: 'Software Developer',
      worksFor: { '@type': 'Organization', name: 'BMO Financial Group' },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: "Queen's University",
        sameAs: 'https://www.queensu.ca/',
      },
      knowsAbout: [
        'Full-stack Development',
        'Reinforcement Learning',
        'Autonomous Vehicles',
        'Robotics',
        'ROS2',
      ],
      description:
        "Teodor Ilie, also known as Teo Ilie, is a full-stack software developer and Queen's University Master's student studying AI and Robotics. He specializes in web development, reinforcement learning, and autonomous robotics.",
    },
    {
      '@type': 'WebSite',
      name: siteName,
      url: Astro.site!.href,
      publisher: { '@type': 'Person', name: profile.name },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload only the weights visible on first paint: body text and headings -->
    <Font cssVariable="--font-body" preload={[{ weight: 300 }]} />
    <Font cssVariable="--font-heading" preload={[{ weight: 600 }]} />

    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/assets/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/favicon-192x192.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Apply the saved/system theme before first paint to avoid a flash -->
    <script is:inline>
      let theme;
      try {
        theme = localStorage.getItem('preferred-theme');
      } catch {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      if (theme === 'dark') document.documentElement.classList.add('dark-theme');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer>
      <p>
        &copy; {new Date().getFullYear()} {profile.name}. All rights reserved. View the{' '}
        <a href="https://github.com/TeoIlie/TeoIlie.github.io" target="_blank" rel="noopener">
          source code on GitHub
        </a>{' '}
        🚀
      </p>
      <p>
        This site is hosted on Cloudflare Pages and uses their{' '}
        <a
          href="https://developers.cloudflare.com/web-analytics/about/"
          target="_blank"
          rel="noopener"
        >
          privacy-first analytics
        </a>
        . Data is collected anonymously to help improve performance and content.
        <br />
        Messages sent via the contact form are transmitted securely and never shared with third
        parties.
      </p>
    </footer>
  </body>
</html>

<style>
  main,
  footer {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  footer {
    text-align: center;
    padding-block: 20px;
    margin-top: 40px;
    border-top: 1px solid var(--footer-top);

    p {
      color: var(--subtitle);
    }
  }
</style>
