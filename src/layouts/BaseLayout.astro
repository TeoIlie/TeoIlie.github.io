---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import photo from '../assets/images/profile-1200.jpg';
import { profile } from '../data/profile';
import { personJsonLd } from '../data/jsonld';
import { siteName } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Social preview image; defaults to the profile photo */
  image?: ImageMetadata;
}

const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const toJpg = async (src: ImageMetadata) =>
  new URL((await getImage({ src, width: 1200, format: 'jpg' })).src, Astro.site).href;
const [photoUrl, pageImage] = await Promise.all([toJpg(photo), image && toJpg(image)]);
const ogImage = pageImage ?? photoUrl;

const jsonLd = personJsonLd(Astro.site!, photoUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload only the weights visible on first paint: body text and headings -->
    <Font cssVariable="--font-sans" preload={[{ weight: 400 }, { weight: 600 }]} />
    <!-- Mono is in the hero's readout strip, so preload it to avoid a late swap -->
    <Font cssVariable="--font-mono" preload={[{ weight: 500 }]} />

    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/assets/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/favicon-192x192.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Apply the saved/system theme before first paint to avoid a flash -->
    <script is:inline>
      let theme;
      try {
        // Saved by the theme toggle in Header.astro
        theme = localStorage.getItem('preferred-theme');
      } catch {}
      if (theme !== 'light' && theme !== 'dark') {
        theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      if (theme === 'dark') document.documentElement.classList.add('dark-theme');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer class="container">
      <p>
        &copy; {new Date().getFullYear()} {profile.name}
      </p>
      <p>
        <a href="https://github.com/TeoIlie/TeoIlie.github.io" target="_blank" rel="noopener">
          Source
        </a>{' '}
        · Hosted on Cloudflare Pages with{' '}
        <a
          href="https://developers.cloudflare.com/web-analytics/about/"
          target="_blank"
          rel="noopener"
        >
          privacy-first analytics
        </a>
      </p>
    </footer>
  </body>
</html>

<style>
  main {
    padding: 0 24px;
  }

  footer {
    padding: 32px 24px 40px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    border-top: 1px solid var(--border);

    p {
      font-size: 13px;
    }

    a {
      color: var(--text-muted);
      text-decoration: underline;
      text-underline-offset: 3px;

      &:hover {
        color: var(--text);
      }
    }
  }
</style>
