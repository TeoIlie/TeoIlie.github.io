---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import LegoGrid from '../components/LegoGrid.astro';
import Contact from '../components/Contact.astro';
import { sections, type SectionId } from '../data/site';

// Section order (and the nav and eyebrow numbers) comes from data/site.ts
const content = {
  about: About,
  experience: Experience,
  projects: Projects,
  lego: LegoGrid,
  contact: Contact,
} satisfies Record<SectionId, unknown>;
---

<BaseLayout
  title="Teodor Ilie | Autonomy Designer at MacLean Engineering | AI & Robotics"
  description="Teodor Ilie is a designer on the Autonomy Team at MacLean Engineering, with an MSc in Computer Science (AI) from Queen's University and research in deep reinforcement learning for autonomous vehicles."
>
  {sections.map(({ id }) => {
    const Content = content[id];
    return (
      <section id={id} class="container">
        <Content />
      </section>
    );
  })}
</BaseLayout>

<style>
  /* Faint blueprint grid behind the hero, fading out as the page scrolls */
  :global(main) {
    position: relative;
    /* The hero racing line bleeds past the container; never let it add horizontal scroll */
    overflow-x: clip;
  }

  :global(main)::before {
    --grid: color-mix(in oklch, var(--text) 6%, transparent);
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 auto;
    height: 900px;
    background:
      linear-gradient(var(--grid) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, var(--grid) 1px, transparent 1px) 0 0 / 40px 40px;
    mask-image: radial-gradient(ellipse 70% 80% at 50% 0%, #000 40%, transparent 100%);
    pointer-events: none;
  }

  section {
    padding-block: clamp(72px, 10vw, 120px);

    & + section {
      border-top: 1px solid var(--border);
    }
  }
</style>
