---
// Cloudflare Pages serves docs/404.html for any unknown path
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkButton from '../components/LinkButton.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title={`Page not found | ${profile.name}`}
  description="This page doesn't exist. Head back to the homepage."
  noindex
>
  <div class="container">
    <span class="eyebrow">Error 404 · Off track</span>
    <h1>Page not found</h1>
    <p>This page doesn't exist, or it moved.</p>
    <div class="link-row">
      <LinkButton name="Home" url="/" icon="solid/house" primary />
      <LinkButton name="Projects" url="/#projects" />
      <LinkButton name="LEGO Technic" url="/#lego" />
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    padding-block: calc(var(--header-height) + 80px) 120px;
  }

  h1 {
    margin-block: 8px 12px;
    font-size: clamp(32px, 5vw, 44px);
  }
</style>
